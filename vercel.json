{
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|svg|gif|ico|woff2|woff|ttf)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(index.html|/)",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=0, s-maxage=86400" }
      ]
    }
  ]
}
